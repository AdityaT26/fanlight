# Copy to .env and adjust. The process environment overrides these values.

# Folder holding articles.json, article_categories.json, tags.json, sources.json, user_preferences.json ...
FANLIGHT_DATA_DIR=data

# Index cache and the SQLite database of readers and interactions
FANLIGHT_STATE_DIR=var

# Feed clock: latest (newest story in the data), now, or an ISO date such as 2024-08-30T12:00:00Z
FANLIGHT_AS_OF=latest

# Only for --source mongo. Never commit a real connection string.
# FANLIGHT_MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/unbiasly
FANLIGHT_MONGO_DB=unbiasly

FANLIGHT_COHORTS=8
